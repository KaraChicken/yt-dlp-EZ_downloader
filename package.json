{
  "name": "yt-dlp-ez-downloader",
  "version": "2.1.0",
  "description": "Secure GUI frontend for yt-dlp",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder"
  },
  "author": {
    "name": "一個路過的詠唱詩人",
    "email": "MoZanYaZe@google.com"
  },
  "license": "ISC",
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.karachicken.ytdlp-ez-downloader",
    "productName": "yt-dlp EZ Downloader",
    "files": [
      "main.js",
      "preload.js",
      "security.js",
      "index.html",
      "js/**/*",
      "css/**/*",
      "README.md",
      "package.json"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "win": { "target": ["nsis", "zip"] },
    "mac": { "target": ["dmg", "zip"] },
    "linux": { "target": ["AppImage", "deb"] }
  }
}
